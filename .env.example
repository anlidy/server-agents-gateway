# Gateway Host & Port
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4180
# Relative paths are resolved against the install directory, not process cwd.
GATEWAY_DB_PATH=./data/gateway.db

# Root admin (only this agent may issue/revoke tokens online)
ROOT_ADMIN_AGENT_ID=admin:root

# Shell
GATEWAY_SHELL_CWD=
GATEWAY_SHELL_TIMEOUT_SECONDS=120
GATEWAY_SHELL_TIMEOUT_MAX=3600

# Audit / trash
GATEWAY_AUDIT_BODY_MAX_BYTES=2097152
GATEWAY_TRASH_RETENTION_DAYS=30

# Status fence refresh
RECONCILE_INTERVAL_SECONDS=60

# OAuth for claude.ai connectors (off unless GATEWAY_PUBLIC_URL is set). See docs/claude-ai.md.
# GATEWAY_PUBLIC_URL=https://sag.example.com
# GATEWAY_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,loopback
# GATEWAY_OAUTH_ONLY_HOSTS=sag.example.com
# GATEWAY_OAUTH_ACCESS_TTL_MINUTES=60
# GATEWAY_OAUTH_REFRESH_TTL_DAYS=30
# GATEWAY_OAUTH_PAIRING_TTL_MINUTES=10
