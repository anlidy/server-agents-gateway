[Unit]
Description=Server Agents Gateway Service
Documentation=https://github.com/anlidy/server-agents-gateway
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/server-agents-gateway
ExecStart=/usr/bin/python3 /opt/server-agents-gateway/server.py
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

# 故意不加 ProtectSystem / ProtectHome / PrivateTmp 等沙箱选项：
# admin agent 的 hub_shell 需要真正的 root（改 /etc、装服务、改 systemd），/tmp 与宿主共享。
# 非 admin（operator）agent 由 SAG 自己降权到普通用户 sag-operator 执行，
# 见 scripts/setup_operator.sh 与 README_zh「权限与风险」。admin token = root，只给可信 agent。

[Install]
WantedBy=multi-user.target